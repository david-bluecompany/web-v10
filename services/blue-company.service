[Unit]
Description=BLUE COMPANY WEB v10.0 Panel Server (FastAPI + HTTPS)
After=network.target

[Service]
Type=simple
User=bluepanel
Group=bluecompany
WorkingDirectory=/opt/blue-company/backend
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/blue-company/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile /etc/bluecompany/ssl/key.pem --ssl-certfile /etc/bluecompany/ssl/cert.pem
Restart=always
RestartSec=2
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
